---
import Layout from "../layouts/Layout.astro";
import ContactLink from "../components/ContactLink.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SkillGroup from "../components/SkillGroup.astro";
import { projects } from "../data/projects";
import { skillGroups } from "../data/skills";
---

<Layout
  title="Ralph Jerome T. Yu — Web Developer Portfolio"
  description="Web developer portfolio of Ralph Jerome T. Yu, featuring practical web projects and clear, useful digital experiences."
>
  <section id="home" aria-labelledby="home-heading" class="hero-technical scroll-mt-28 border-b border-[var(--color-border)]">
    <div class="relative z-10 mx-auto grid min-h-[calc(100vh-9rem)] max-w-6xl items-center gap-10 px-[var(--space-page-x)] py-[var(--space-section-y)] sm:px-6 lg:grid-cols-[minmax(0,1fr)_9rem] lg:px-8 lg:py-28">
      <div class="hero-copy max-w-5xl">
        <p class="hero-label"><span>00</span> / portfolio.ts</p>
        <h1 id="home-heading" class="mt-6 max-w-5xl text-5xl font-extrabold leading-none tracking-normal text-[var(--color-text-primary)] sm:text-7xl lg:text-8xl xl:text-9xl">
          Ralph <br class="sm:hidden" />Jerome
          <span class="block">T. Yu</span>
        </h1>
        <p class="mt-6 text-xl font-semibold text-[var(--color-text-secondary)] sm:text-2xl lg:text-3xl">
          Web Developer
        </p>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-text-secondary)]">
          My work sits between structure and expression—building web experiences that are useful, considered, and clear.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="#projects"
            class="inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-[var(--color-accent-foreground)] transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
          >
            View Projects
          </a>
          <a
            href="#contact"
            class="inline-flex min-h-11 items-center justify-center px-2 py-3 text-sm font-semibold text-[var(--color-text-secondary)] underline-offset-4 transition hover:text-[var(--color-accent)] hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)] sm:px-3"
          >
            Contact Ralph
          </a>
          <a
            href="/ralph-yu-resume.pdf"
            download="ralph-yu-resume.pdf"
            aria-label="Download Ralph Jerome T. Yu's resume as a PDF"
            class="inline-flex min-h-11 items-center justify-center px-2 py-3 text-sm font-semibold text-[var(--color-text-secondary)] underline-offset-4 transition hover:text-[var(--color-accent)] hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)] sm:px-3"
          >
            Resume / PDF
          </a>
        </div>
      </div>

      <div class="hero-signature" aria-hidden="true">RY</div>
    </div>
  </section>

  <section id="about" aria-labelledby="about-heading" class="scroll-mt-28 bg-[var(--color-surface)]">
    <div class="mx-auto grid max-w-6xl gap-10 px-[var(--space-page-x)] py-[var(--space-section-y)] sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <SectionHeading
        eyebrow="About"
        marker="01"
        headingId="about-heading"
        title="A practical portfolio from an aspiring web developer."
        description="Ralph Jerome T. Yu is an aspiring web developer and a passionate, hardworking individual. He values loyalty and collaboration as a teammate, and he keeps learning through hands-on problem solving."
      />

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] p-6">
          <h3 class="text-lg font-bold text-[var(--color-text-primary)]">Web Development Direction</h3>
          <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
            Focused on growing as an aspiring web developer through practical projects and steady skill-building.
          </p>
        </div>
        <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-background)] p-6">
          <h3 class="text-lg font-bold text-[var(--color-text-primary)]">Hands-On Learning</h3>
          <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
            Develops technical repair and freelancing skills through hands-on problem solving.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-heading" class="scroll-mt-28">
    <div class="mx-auto max-w-6xl px-[var(--space-page-x)] py-[var(--space-section-y)] sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Skills"
        marker="02"
        headingId="skills-heading"
        title="Technical skills Ralph is building with."
        description="A focused stack for building practical web applications, from typed frontend interfaces to backend services, databases, version control, and deployment."
      />

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {skillGroups.map((group) => <SkillGroup group={group} />)}
      </div>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-heading" class="scroll-mt-28">
    <div class="mx-auto max-w-6xl px-[var(--space-page-x)] py-[var(--space-section-y)] sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Projects"
        marker="03"
        headingId="projects-heading"
        title="Featured web projects"
        description="Two portfolio projects centered on practical services: booking management for a resort and a school lost and found experience."
      />

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-heading" class="scroll-mt-28 bg-[var(--color-surface)]">
    <div class="mx-auto max-w-6xl px-[var(--space-page-x)] py-[var(--space-section-y)] sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Contact"
        marker="04"
        headingId="contact-heading"
        title="Get in touch with Ralph."
        description="For recruiter conversations, client inquiries, or tech support opportunities, use the links below."
      />

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <ContactLink href="mailto:yuralphjerome@gmail.com" label="Email" value="yuralphjerome@gmail.com" />
        <ContactLink href="tel:09994408356" label="Phone" value="0999-440-8356" />
        <ContactLink
          href="https://github.com/lts-razz"
          label="GitHub"
          value="github.com/lts-razz"
          ariaLabel="Visit Ralph Jerome T. Yu on GitHub"
          external
        />
        <ContactLink
          href="https://www.facebook.com/DiBaITKa"
          label="Freelance Business"
          value="facebook.com/DiBaITKa"
          ariaLabel="Visit Ralph Jerome T. Yu's freelance business page"
          external
        />
      </div>
    </div>
  </section>
</Layout>
