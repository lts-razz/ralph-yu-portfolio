---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, features, image, repositoryUrl, liveUrl } = project;
---

<article class="project-card group flex h-full flex-col overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm transition motion-safe:hover:-translate-y-1 hover:border-[var(--color-accent)] hover:shadow-md">
  <div class="project-card__media aspect-video w-full overflow-hidden bg-[var(--color-surface-elevated)]">
    <span class="project-card__chrome" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <img src={image.src} alt={image.alt} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold text-[var(--color-text-primary)]">{title}</h3>
    <p class="mt-4 flex-1 leading-7 text-[var(--color-text-secondary)]">{description}</p>
    {
      features && (
        <div class="mt-6 border-t border-[var(--color-border)] pt-4">
          <h4 class="text-sm font-semibold text-[var(--color-text-primary)]">Features</h4>
          <ul class="mt-3 grid gap-2 text-sm text-[var(--color-text-secondary)]">
            {features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a
        href={liveUrl}
        class="inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-[var(--color-accent-foreground)] transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View live project for ${title}`}
      >
        View Live Project
      </a>
      {
        repositoryUrl && (
          <a
            href={repositoryUrl}
            class="inline-flex items-center justify-center font-semibold text-[var(--color-accent)] transition hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View GitHub repository for ${title}`}
          >
            View repository
          </a>
        )
      }
    </div>
  </div>
</article>
