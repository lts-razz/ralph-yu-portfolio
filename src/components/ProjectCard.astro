---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const {
  marker,
  type,
  title,
  role,
  contributionAreas,
  description,
  supportingAreas,
  technologies,
  integrations,
  image,
  repositoryUrl,
  liveUrl,
} = project;
const isReversed = marker === "02";
---

<article class:list={["project-band", { "project-band--reverse": isReversed }]}>
  <div class="project-band__intro">
    <p class="font-mono text-xs font-semibold leading-6 tracking-[0.08em] text-[var(--color-accent)] sm:text-sm">
      {marker} / {type}
    </p>
    <h3 class="mt-3 text-3xl font-extrabold leading-tight tracking-normal text-[var(--color-text-primary)] sm:text-4xl">
      {title}
    </h3>
    <p class="mt-5 text-base leading-8 text-[var(--color-text-secondary)] sm:text-lg sm:leading-9">
      {description}
    </p>
  </div>

  <figure class="project-band__media">
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
  </figure>

  <div class="project-band__details">
    <dl>
      <div>
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      {
        contributionAreas && (
          <div>
            <dt>Focus</dt>
            <dd>{contributionAreas}</dd>
          </div>
        )
      }
      <div>
        <dt>Workflow</dt>
        <dd>{supportingAreas}</dd>
      </div>
      <div>
        <dt>Built with</dt>
        <dd>{technologies}</dd>
      </div>
      {
        integrations && (
          <div>
            <dt>Integrations</dt>
            <dd>{integrations}</dd>
          </div>
        )
      }
    </dl>
  </div>

  <div class="project-band__actions">
    <a
      href={liveUrl}
      class="project-band__primary inline-flex min-h-11 items-center justify-center rounded-md bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-[var(--color-accent-foreground)] transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View live project for ${title}`}
    >
      View live project
    </a>
    <a
      href={repositoryUrl}
      class="project-band__secondary inline-flex min-h-11 items-center justify-center px-1 py-3 text-sm font-semibold text-[var(--color-accent)] underline-offset-4 transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View source for ${title}`}
    >
      View source
    </a>
  </div>
</article>
