---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-[var(--color-text-secondary)] sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <p>&copy; {year} Ralph Jerome T. Yu. All rights reserved.</p>
    <a
      href="/#home"
      class="font-medium text-[var(--color-text-primary)] transition hover:text-[var(--color-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
    >
      Back to top
    </a>
  </div>
</footer>
