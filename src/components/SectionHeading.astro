---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  <p class="text-sm font-semibold tracking-[0.2em] text-[var(--color-accent)] uppercase">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-bold text-[var(--color-text-primary)] sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-[var(--color-text-secondary)] sm:text-lg">{description}</p>}
</div>
