---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  headingId?: string;
  marker?: string;
}

const { eyebrow, title, description, headingId, marker } = Astro.props;
---

<div class="section-heading max-w-3xl">
  <div class="flex items-center gap-3">
    {marker && <span class="section-marker" aria-hidden="true">{marker}</span>}
    <p class="text-sm font-semibold tracking-[0.2em] text-[var(--color-accent)] uppercase">{eyebrow}</p>
  </div>
  <h2 id={headingId} class="mt-3 text-3xl font-bold text-[var(--color-text-primary)] sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-[var(--color-text-secondary)] sm:text-lg">{description}</p>}
</div>
